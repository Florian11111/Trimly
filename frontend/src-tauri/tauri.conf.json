{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trimly",
  "version": "../package.json",
  "identifier": "io.github.florian11111.trimly",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "BROWSER=none npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Trimly",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#08091a",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Cut and compress videos",
    "longDescription": "Lightweight and fast tool to cut and compress videos, with hardware encoding.",    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/trimly.desktop",
        "depends": ["ffmpeg", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      },
      "rpm": {
        "desktopTemplate": "linux/trimly.desktop"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v"
        ],
        "name": "MP4-Video",
        "description": "MP4-Video",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "video/mp4",
        "contentTypes": [
          "public.mpeg-4",
          "com.apple.m4v-video"
        ]
      },
      {
        "ext": [
          "mov"
        ],
        "name": "QuickTime-Video",
        "description": "QuickTime-Video",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "video/quicktime",
        "contentTypes": [
          "com.apple.quicktime-movie"
        ]
      },
      {
        "ext": [
          "mkv"
        ],
        "name": "Matroska-Video",
        "description": "Matroska-Video",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "video/x-matroska",
        "contentTypes": [
          "org.matroska.mkv"
        ]
      },
      {
        "ext": [
          "webm"
        ],
        "name": "WebM-Video",
        "description": "WebM-Video",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "video/webm",
        "contentTypes": [
          "org.webmproject.webm"
        ]
      },
      {
        "ext": [
          "avi"
        ],
        "name": "AVI-Video",
        "description": "AVI-Video",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "video/x-msvideo",
        "contentTypes": [
          "public.avi"
        ]
      }
    ]
  }
}
