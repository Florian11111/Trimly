; Leftovers of the old per-user association (empty default that hides the entries above)
[HKEY_CURRENT_USER\Software\Classes\.mp4]
@=-
"MP4-Video_backup"=-
[HKEY_CURRENT_USER\Software\Classes\.m4v]
@=-
"MP4-Video_backup"=-
[HKEY_CURRENT_USER\Software\Classes\.mov]
@=-
"QuickTime-Video_backup"=-
[HKEY_CURRENT_USER\Software\Classes\.mkv]
@=-
"Matroska-Video_backup"=-
[HKEY_CURRENT_USER\Software\Classes\.webm]
@=-
"WebM-Video_backup"=-
[HKEY_CURRENT_USER\Software\Classes\.avi]
@=-
"AVI-Video_backup"=-
[-HKEY_CURRENT_USER\Software\Classes\MP4-Video]
[-HKEY_CURRENT_USER\Software\Classes\QuickTime-Video]
[-HKEY_CURRENT_USER\Software\Classes\Matroska-Video]
[-HKEY_CURRENT_USER\Software\Classes\WebM-Video]
[-HKEY_CURRENT_USER\Software\Classes\AVI-Video]
