Windows Registry Editor Version 5.00

; Repairs the Windows entries for .mp4, .m4v, .mov, .mkv, .webm and .avi that the
; Trimly .msi of older versions removed on uninstall/update (no video thumbnails in Explorer anymore).
; Also removes the leftovers of the old NSIS file associations.
; Run by double-clicking (needs administrator rights), then restart Explorer or sign out.

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.mp4]
@="WMP11.AssocFile.MP4"
"Content Type"="video/mp4"
"PerceivedType"="video"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.mp4\OpenWithProgIds]
"WMP11.AssocFile.MP4"=hex(0):
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.mp4\ShellEx\{BB2E617C-0920-11D1-9A0B-00C04FC2D6C1}]
@="{9DBD2C50-62AD-11D0-B806-00C04FD706EC}"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.mp4\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}]
@="{9DBD2C50-62AD-11D0-B806-00C04FD706EC}"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.m4v]
@="WMP11.AssocFile.MP4"
"Content Type"="video/x-m4v"
"PerceivedType"="video"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.m4v\OpenWithProgIds]
"WMP11.AssocFile.MP4"=hex(0):
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.m4v\ShellEx\{BB2E617C-0920-11D1-9A0B-00C04FC2D6C1}]
